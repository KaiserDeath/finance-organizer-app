<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Package visibility (Android 11+): declaring these lets getLaunchIntentForPackage()
      resolve Peru bank / e-wallet apps so we can deep-link into them. The market intent
      covers the Play Store fallback. VERIFY these ids before release.
    -->
    <queries>
        <package android:name="com.bcp.innovacxion.yapeapp" />
        <package android:name="pe.com.bcp.bancamovil" />
        <package android:name="pe.interbank.mobilebanking" />
        <package android:name="com.bbva.nxt_peru" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".MoneyFlowApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoneyFlow">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MoneyFlow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
